# Neon Postgres connection string (from the Neon console: https://console.neon.tech).
# On Vercel the Neon integration provides it; with a variable prefix it is
# named STORAGE_DATABASE_URL instead, which the code also reads.
DATABASE_URL="postgres://..."

# Team passkey for the writing Studio at /studio. Required: without it the
# Studio stays locked. Use a long, private value (never a known one).
STUDIO_ADMIN_PASSKEY="choose-a-long-private-passphrase"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Server only: Paystack secret key for organisation payments (/api/paystack/initialize).
# Set it in your hosting environment; never commit a real key.
PAYSTACK_SECRET_KEY="sk_test_xxx"

# Server only: Resend API key for transactional emails
# Sign up at https://resend.com and generate an API key.
# In development, if omitted, emails will be safely simulated in the server console.
RESEND_API_KEY="re_xxx"

# Sender address: use "onboarding@resend.dev" for initial testing before custom domain setup,
# or "Mikaelson Initiative <hello@mikaelsoninitiative.org>" once your domain is verified on Resend.
EMAIL_FROM="Mikaelson Initiative <hello@mikaelsoninitiative.org>"

# Recipient mailboxes for team alerts (optional overrides)
TEAM_EMAIL_GENERAL="hello@mikaelsoninitiative.org"
TEAM_EMAIL_PARTNERSHIP="partnership@mikaelsoninitiative.org"
TEAM_EMAIL_DONATIONS="partnership@mikaelsoninitiative.org"
TEAM_EMAIL_CONDUCT="conduct@mikaelsoninitiative.org"
